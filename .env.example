# Hand Recognition Agent (required unless --lip-only or --hand-results is used)
OPENAI_API_KEY=
OPENAI_HAND_MODEL=gpt-4.1
OPENAI_IMAGE_DETAIL=high

# Self-Correction P2W Agent (required unless --no-self-correction is used)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_MAX_TOKENS=4096
